{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student user profile information, pacing targets, and exam settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student"] },
        "targetExam": { "type": "string" },
        "targetGrade": { "type": "string" },
        "targetPacingSeconds": { "type": "number" },
        "examDate": { "type": "string" },
        "enrolledSubjects": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Student completed exam session with score, pacing timeline and evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "paperTitle": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "scoreAchieved": { "type": "number" },
        "totalMarks": { "type": "number" },
        "avgSecondsPerMark": { "type": "number" },
        "targetSecondsPerMark": { "type": "number" },
        "pacingDisciplineGrade": { "type": "string" },
        "panicSpikesDetected": { "type": "number" },
        "questions": { "type": "array" }
      },
      "required": ["id", "studentId", "scoreAchieved", "totalMarks"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual student profile and preferences"
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": "ExamAttempt",
      "description": "Exam session attempts and pacing diagnostics"
    }
  }
}
